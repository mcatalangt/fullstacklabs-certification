@echo off
setlocal enabledelayedexpansion

REM Always operate on the repository root, regardless of where this is invoked from
cd /d "%~dp0"

set APP_DIR=codebase\rdicidr-0.1.0
set FILE_NAME=assessment-cc-agentic-devops-gcp-kubernetes-sr-01.zip
set ZIP_FILE_FULL_PATH=%CD%\!FILE_NAME!

REM tar.exe (bsdtar) ships with Windows 10 1803+. It replaces Compress-Archive,
REM which this script used to call through Get-ChildItem -- and Get-ChildItem
REM without -Force skips hidden items, so .git\ and .chat-history\ were silently
REM omitted from every archive a Windows candidate produced.
where tar.exe >nul 2>&1
if errorlevel 1 (
    echo [31mERROR: tar.exe not found.[0m
    echo tar.exe ships with Windows 10 build 17063 and later and is required here,
    echo because PowerShell's Compress-Archive silently omits hidden files such as
    echo .git and .chat-history.
    echo Please update Windows, or create the zip with 7-Zip / WSL instead.
    exit /b 1
)

REM Remove generated folders
echo Removing unnecessary autogenerated folders and files

REM Javascript libraries and frameworks
rmdir /s /q !APP_DIR!\node_modules 2>nul
rmdir /s /q !APP_DIR!\dist 2>nul
rmdir /s /q !APP_DIR!\build 2>nul
rmdir /s /q !APP_DIR!\out 2>nul
rmdir /s /q !APP_DIR!\tmp 2>nul

echo [32mUnnecessary autogenerated folders and files removed successfully[0m

echo Compressing challenge into !FILE_NAME!

REM NOTE: .git\, codebase\rdicidr-0.1.0\.github\, .chat-history\ and k8s\ are all
REM graded artifacts and MUST be included. Do not add a
REM .git exclude here -- the equivalent glob also matches .github, which is where
REM the CI pipeline that Part 1 is graded on lives.
REM
REM .terraform\providers is excluded defensively. No Terraform ships with this
REM challenge, but the CD section invites deploying to GCP with any GCP service
REM (e.g. Cloud Run or GKE) -- provisioning that with Terraform is a plausible
REM route, and a candidate who runs terraform init ends up with a provider cache
REM of hundreds of MB. The rule costs nothing when the directory does not exist.
REM Everything else under .terraform stays, since it is small and can reflect
REM real design decisions.
del /q "!ZIP_FILE_FULL_PATH!" 2>nul

tar.exe -a -c -f "!ZIP_FILE_FULL_PATH!" ^
    --exclude=!FILE_NAME! ^
    --exclude=*/node_modules/* ^
    --exclude=node_modules ^
    --exclude=*/.terraform/providers/* ^
    --exclude=.terraform/providers ^
    --exclude=.DS_Store ^
    .

if errorlevel 1 (
    echo [31mERROR: archive creation failed.[0m
    exit /b 1
)

echo [32mCompression complete: !ZIP_FILE_FULL_PATH![0m

REM ---------------------------------------------------------------------------
REM Self-check: the submission is graded from these paths. Fail loudly if any of
REM them did not make it into the archive.
REM ---------------------------------------------------------------------------
echo.
echo Verifying submission contents...

set FAILED=0

REM tar.exe stores members with a leading "./". The trailing "..*" requires at
REM least one character after the directory separator, so a bare directory entry
REM does not satisfy the check -- an empty folder must FAIL, which is the only
REM thing this check exists to catch. findstr has no "+", hence "..*".
call :check ".git/                (commit history / PR progression)"     "/\.git/..*"
call :check ".github/workflows/   (CI pipeline)"                         "/codebase/rdicidr-0\.1\.0/\.github/workflows/..*"
call :check ".chat-history/       (AI interaction logs)"                 "/\.chat-history/..*"
call :check "k8s/                 (Kubernetes manifests)"                 "/k8s/..*"
call :check "src/                 (application source)"                  "/codebase/rdicidr-0\.1\.0/src/..*"
call :check "Dockerfile           (container build)"                     "/codebase/rdicidr-0\.1\.0/Dockerfile"
call :check "package.json         (CI install/lint/test/build)"          "/codebase/rdicidr-0\.1\.0/package\.json"

call :not_present "node_modules" "node_modules"
call :not_present ".terraform/providers plugin cache" "/\.terraform/providers/"

echo.
if !FAILED! neq 0 (
    echo [31mSubmission is INCOMPLETE. Create the missing directories, populate them, and re-run this script.[0m
    echo [31mNote that .chat-history\ does not ship with the challenge -- you are expected to create it.[0m
    exit /b 1
)

echo [32mSubmission looks complete: !FILE_NAME![0m

timeout /t 2 /nobreak >nul

exit /b 0

:check
tar.exe -tf "!ZIP_FILE_FULL_PATH!" | findstr /v /c:"/.gitkeep" | findstr /r %~2 >nul 2>&1
if errorlevel 1 (
    echo   [31mFAIL[0m  %~1  ^(missing from archive, or contains no files^)
    set FAILED=1
) else (
    echo   [32mPASS[0m  %~1
)
goto :eof

:not_present
tar.exe -tf "!ZIP_FILE_FULL_PATH!" | findstr /r %~2 >nul 2>&1
if errorlevel 1 (
    echo   [32mPASS[0m  %~1 excluded
) else (
    echo   [31mFAIL[0m  %~1 leaked into the archive
    set FAILED=1
)
goto :eof
